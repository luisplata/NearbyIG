# Configuración local de la API. Copiá el archivo y ajustá lo que necesites:
#
#   cp .env.example .env
#
# El `.env` está ignorado por git. No hay secretos reales acá: los valores son
# los del compose local y el JWT de desarrollo es explícitamente inseguro.

# development | test | production
NODE_ENV=development

# Puerto HTTP de la API (host y contenedor).
PORT=3000

# Conexión desde el HOST (tests de integración, `npm run migrate` sin Docker).
# Dentro de compose la API usa `db:5432` y esto se sobreescribe solo.
DATABASE_URL=postgres://nearbyig:nearbyig@localhost:5432/nearbyig

# Credenciales del contenedor `db` (compose). No son de producción.
POSTGRES_DB=nearbyig
POSTGRES_USER=nearbyig
POSTGRES_PASSWORD=nearbyig

# Puerto publicado de Postgres en `compose.dev.yml`.
POSTGRES_PORT=5432

# Secreto del JWT de sesión demo. En producción es obligatorio (32+ caracteres)
# y la API no arranca si falta.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# Vida de la sesión demo, en segundos (2 h).
SESSION_TTL_SECONDS=7200

# Región que se usa cuando `POST /auth/demo-session` no recibe body.
DEFAULT_REGION_KEY=mx
