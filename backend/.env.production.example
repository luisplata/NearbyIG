# Variables de PRODUCCIÓN de la demo NearbyIG.
#
#   cp .env.production.example .env.production
#   # editar, y desplegar con --env-file .env.production
#   docker compose --env-file .env.production -f compose.yml -f compose.prod.yml config
#
# El archivo con valores reales NO se versiona (`.env.*` está en `.gitignore`;
# sólo los `*.example` van al repo). Este ejemplo no tiene secretos: los valores
# de abajo son marcadores, no los que usa ningún deploy.
#
# Regla del proyecto: lo obligatorio se declara obligatorio. `compose.prod.yml`
# usa `${VAR:?mensaje}`, así que un deploy sin estas variables **no arranca** en
# vez de arrancar a medias con un default de desarrollo.

# --- Base de datos -----------------------------------------------------------
# Postgres administrado: el Droplet no levanta el servicio `db` en producción.
# En el ejemplo el host es el nombre de un contenedor/managed DB; en el Droplet
# real puede ser una IP privada o el endpoint del proveedor.
# Requisito: PostgreSQL 16 con la extensión PostGIS 3.4 disponible
# (`CREATE EXTENSION postgis` la habilita la migración 001).
DATABASE_URL=postgres://nearbyig:CAMBIAR_ESTA_CLAVE@postgres.internal:5432/nearbyig

# --- Sesión demo -------------------------------------------------------------
# Obligatorio, mínimo 32 caracteres. Generarlo con:  openssl rand -hex 32
# Un secreto corto aborta el boot (`env.ts`).
JWT_SECRET=CAMBIAR_32_CARACTERES_ALEATORIOS_MINIMO

# Vida de la sesión demo en segundos (2 h). Opcional.
SESSION_TTL_SECONDS=7200

# --- CORS --------------------------------------------------------------------
# Obligatorio. El `Origin` de la PÁGINA que sirve el JS, no el de la API:
#   * sitio de usuario  → https://luisplata.github.io
#   * sitio de proyecto → https://luisplata.github.io  (el navegador manda el host, sin /NearbyIG)
# Nunca `*`: el boot lo rechaza. Sin esta variable no se emiten headers CORS y el
# navegador de Pages no puede llamar la API (falla cerrado).
CORS_ALLOWED_ORIGINS=https://luisplata.github.io

# --- Operación de la demo ----------------------------------------------------
# Token del reset global (`POST /demo/reset`). 24+ caracteres.
# Si queda vacío, en producción el endpoint responde 401 y la demo no se puede
# resetear desde ningún lado; configurarlo es parte del deploy.
# Se usa así, desde la terminal del Droplet:
#   curl -X POST https://api.example.com/demo/reset -H "Authorization: Bearer $DEMO_RESET_TOKEN"
DEMO_RESET_TOKEN=CAMBIAR_24_CARACTERES_MINIMO

# Ventana mínima entre resets globales, en ms (PS-11: uno cada 10 s).
DEMO_RESET_MIN_INTERVAL_MS=10000

# Región por defecto si el cliente no elige zona (mx | co). Opcional.
DEFAULT_REGION_KEY=mx

# --- Red ---------------------------------------------------------------------
# Puerto de loopback que publica la API. El reverse proxy del host (Caddy/nginx)
# es el único que ve internet y termina TLS. Opcional, default 3000.
PORT=3000

# --- Backup (sólo para los scripts, no lo lee la API) ------------------------
# `scripts/backup-db.sh` y `scripts/restore-db.sh` usan DATABASE_URL para el modo
# de base administrada; no hace falta duplicarla acá.
