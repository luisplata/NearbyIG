# Variables del VPS ÚNICO (un solo servidor, todo en Docker).
#
#   cp .env.vps.example .env.vps
#   # completar los secretos y desplegar:
#   docker compose --env-file .env.vps -f compose.yml -f compose.prod.yml --profile local-db up -d
#
# Diferencia con `.env.production.example`: ese asume Postgres ADMINISTRADO
# (el servicio `db` dormido). Éste activa el perfil `local-db`, así que Postgres
# corre en el mismo VPS y `DATABASE_URL` apunta al nombre del servicio `db`.
#
# El archivo con valores reales NO se versiona: `.env.*` está en `.gitignore`.
# En el servidor, dejalo en `chmod 600` y dueño del usuario del deploy.
#
# Regla del proyecto: lo obligatorio se declara obligatorio. `compose.prod.yml`
# usa `${VAR:?mensaje}`, así que un deploy sin estas variables **no arranca** en
# vez de arrancar a medias con un default de desarrollo.

# --- Base de datos (contenedor `db`) ----------------------------------------
# `CAMBIAR` es un marcador, no un valor: si lo dejás así el deploy arranca con la
# clave del template. Generá la real con `openssl rand -hex 24`.
# OJO: la misma clave aparece en dos lugares (el contenedor la usa para
# inicializar el rol, la API para conectar). Si rotás una, rotá la otra; si no,
# la API entra con credenciales que Postgres nunca creó.
POSTGRES_DB=nearbyig
POSTGRES_USER=nearbyig
POSTGRES_PASSWORD=CAMBIAR

# conexión interna: el host es el servicio `db` de compose, nunca `localhost`
# (la API vive en otro contenedor) ni una IP pública.
DATABASE_URL=postgres://nearbyig:CAMBIAR@db:5432/nearbyig

# --- Sesión demo ------------------------------------------------------------
# Obligatorio, mínimo 32 caracteres. Generar:  openssl rand -hex 32
JWT_SECRET=CAMBIAR
SESSION_TTL_SECONDS=7200

# --- CORS -------------------------------------------------------------------
# Obligatorio. Sólo aplica al FRONT WEB: el `Origin` es `scheme://host[:port]`
# de la página que ejecuta el JS, sin path y sin barra final.
#   GitHub Pages      → https://luisplata.github.io   (sin /NearbyIG)
#   dominio propio    → https://nearbyig.tech,https://www.nearbyig.tech
# Las apps nativas (APK/IPA) NO mandan `Origin`: CORS no las afecta nunca.
# Nunca `*`: el boot lo rechaza. Sin esta variable no se emiten headers CORS.
CORS_ALLOWED_ORIGINS=https://luisplata.github.io,https://nearbyig.tech,https://www.nearbyig.tech

# --- Operación de la demo ---------------------------------------------------
# Token del reset global (`POST /demo/reset`). 24+ caracteres, o vacío para
# deshabilitar el endpoint en producción. Generar:  openssl rand -hex 24
# `CAMBIAR` (7 caracteres) NO pasa el mínimo: es el marcador que te obliga a ponerlo.
DEMO_RESET_TOKEN=CAMBIAR
DEMO_RESET_MIN_INTERVAL_MS=10000
DEFAULT_REGION_KEY=mx

# --- Red --------------------------------------------------------------------
# Puerto de loopback que publica la API. Caddy/nginx en el host es el único que
# ve internet y termina TLS.
PORT=3000

# --- Operación del server (no las lee la API) -------------------------------
# Dominio público del API. Lo consume el Caddyfile del host, no compose.
API_DOMAIN=api.example.com
ACME_EMAIL=luisplata@gmail.com

# Tag de la imagen publicada por CI en GHCR. Requiere el overlay `compose.vps.yml`
# (todavía no existe: hoy `compose.yml` fija `image: nearbyig-api:local`).
# Imagen de la API. `compose.vps.yml` la usa para `api` y `migrate` en vez de
# construir. Hoy se sube con `docker save | ssh docker load`; el día que exista
# el workflow, esto pasa a `ghcr.io/luisplata/nearbyig-api:<sha>`.
NEARBYIG_IMAGE=nearbyig-api:0.1.0
