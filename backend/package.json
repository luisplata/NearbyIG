{
  "name": "@nearbyig/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NearbyIG demo API: NestJS + PostGIS, contract-first (Sprint 1)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "concurrently -k -n tsc,node -c cyan,green \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --inspect=0.0.0.0:9229 dist/main.js\"",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "migrate:rollback": "node scripts/migrate.mjs --rollback",
    "seed": "node scripts/seed.mjs",
    "seed:check": "node scripts/seed.mjs --check",
    "db:setup": "npm run migrate && npm run seed",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\""
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  }
}
