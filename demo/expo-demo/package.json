{
  "name": "nearbyig-expo-demo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "node ./scripts/copy-maplibre-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden:update": "node ./scripts/golden.mjs",
    "smoke:live": "vitest run test/live.smoke.test.ts",
    "serve:dist": "node ./scripts/serve-dist.mjs dist",
    "export:web": "expo export --platform web --output-dir dist --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@maplibre/maplibre-react-native": "11.5.1",
    "expo": "^58.0.24",
    "expo-font": "~58.0.12",
    "expo-location": "~58.0.21",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "maplibre-gl": "6.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
